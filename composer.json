{
    "name": "kinetis/queue",
    "description": "A backend-agnostic background job queue for Kinetis — Redis and SQL (MySQL/Postgres) backends included, no fluent job-scheduling DSL.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alon Noy"
        }
    ],
    "require": {
        "php": "^8.4",
        "kinetis/framework": "^1.19.1",
        "kinetis/persistence": "^1.10.2",
        "kinetis/cache-redis": "^1.0.5",
        "amphp/redis": "^2.0",
        "psr/container": "^2.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "infection/infection": "^0.34.2",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "vimeo/psalm": "^6.16"
    },
    "suggest": {
        "ext-pcntl": "Lets `kinetis queue:work` stop gracefully on SIGTERM, finishing the job in flight instead of being killed mid-job. Not loaded by default in the official PHP Docker images."
    },
    "autoload": {
        "psr-4": {
            "Kinetis\\Queue\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetis\\Queue\\Tests\\": "tests/"
        }
    },
    "extra": {
        "kinetis": {
            "scan": "Kinetis\\Queue\\Console\\",
            "bootstrap": "Kinetis\\Queue\\PackageBootstrap"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
